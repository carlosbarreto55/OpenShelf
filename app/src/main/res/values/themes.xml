<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Window-level chrome only; the in-app palette lives in ui/theme/Color.kt. -->
    <style name="Theme.PaperReader" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/lattice_light_primary</item>
        <item name="colorOnPrimary">@color/lattice_light_on_primary</item>
        <item name="android:windowBackground">@color/lattice_light_background</item>
        <!-- Edge-to-edge: MainActivity draws behind the system bars. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
